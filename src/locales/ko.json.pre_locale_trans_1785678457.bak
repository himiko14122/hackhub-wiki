  "category_stat_guides_2_value": "전체 게임",
  "category_stat_tools_0_label": "핵심 도구",
  "category_stat_tools_0_value": "5+",
  "category_stat_tools_1_label": "실제 세계에서 영감",
  "category_stat_tools_1_value": "100%",
  "category_stat_tools_2_label": "업그레이드 가능",
